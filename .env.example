# ============================================
# LIMS Docker 部署配置（完整版）
# 由 deploy.bat 自动生成，也可手动编辑
# ============================================

# ─────────────────────────────────────────────
# 🎯 Django 后端配置
# ─────────────────────────────────────────────

# Django 安全密钥 (必填)
# 生成: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# 允许访问的主机 (必填，逗号分隔)
# 示例: localhost,127.0.0.1,192.168.1.100,your-domain.com
ALLOWED_HOSTS=*

# CORS 跨域允许的源 (逗号分隔)
# * = 允许所有（开发环境）
# 生产环境建议指定具体域名: http://your-domain.com
CORS_ALLOWED_ORIGINS=*

# 密码加密密钥 (必填，32位字符)
# 前后端必须一致！用于登录密码AES加密传输
# 生成: openssl rand -base64 32 | head -c 32
PASSWORD_ENCRYPT_KEY=
VITE_PASSWORD_ENCRYPT_KEY=

# ─────────────────────────────────────────────
# 🗄️ MySQL 数据库配置
# ─────────────────────────────────────────────

DB_NAME=lims
DB_USER=lims
DB_PASSWORD=
DB_ROOT_PASSWORD=

# ─────────────────────────────────────────────
# 🌐 前端 API 配置
# ─────────────────────────────────────────────

# 前端请求的后端API地址 (Docker内部用)
# Docker部署时通常不需要改，因为Nginx会代理 /api/ 到后端
# 格式: http://host:port/api/v1 或 /api/v1 (相对路径)
VITE_API_V2_BASE_URL=/api/v1

# ─────────────────────────────────────────────
# 🚀 服务端口配置
# ─────────────────────────────────────────────

# Nginx 对外服务端口
SERVER_PORT=80
HTTPS_PORT=443

# ─────────────────────────────────────────────
# 🤖 AI 功能配置 (可选)
# ─────────────────────────────────────────────

DEEPSEEK_API_KEY=
DEEPSEEK_SERVICE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat