# ============================================
# Docker Compose 生产环境配置
# 使用方法: 复制此文件为 .env 并修改配置值
# 或者直接运行 ./deploy.sh 自动生成
# ============================================

# Django 密钥 (必填)
# 生成命令: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# 或: openssl rand -base64 50
SECRET_KEY=your-secret-key-change-me

# 允许的主机 (必填，多个用逗号分隔)
# 注意：必须包含 localhost 和 127.0.0.1，否则健康检查会失败
# 例如: 192.168.1.100,localhost,127.0.0.1
ALLOWED_HOSTS=192.168.1.100,localhost,127.0.0.1

# 服务端口 (可选，默认: 8080)
SERVER_PORT=8080

# CORS 允许的前端域名 (必填)
# 例如: http://192.168.1.100:8080
CORS_ALLOWED_ORIGINS=http://192.168.1.100:8080

# 数据库名称 (可选，默认: sxsinfo)
DB_NAME=sxsinfo

# 数据库密码 (必填)
# 注意：数据库用户名(hanhan)在 docker-compose.yml 中已固定
DB_PASSWORD=your-secure-db-password
 
# 数据库 Root 密码 (必填)
# MySQL 容器初始化需要设置 root 密码
DB_ROOT_PASSWORD=your-root-password

# 密码加密密钥 (必填，生产环境)
# 用于前端登录密码 AES 加密，必须是 32 位字符
# 生成命令: openssl rand -base64 32 | head -c 32
PASSWORD_ENCRYPT_KEY=

# 前端密码加密密钥 (必填，值必须与上面相同)
# 注意：Vite 环境变量必须以 VITE_ 开头才能被前端访问
VITE_PASSWORD_ENCRYPT_KEY=

# DeepSeek API 配置 (可选，用于DeepSeek AI功能)
# 获取API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_SERVICE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
