# 环境变量配置示例

# Django配置
DJANGO_ENV=development
SECRET_KEY=your-secret-key-here

# 数据库配置
DB_NAME=lims
DB_USER=root
DB_PASSWORD=your-password
DB_HOST=localhost
DB_PORT=3306

# Redis配置
REDIS_URL=redis://localhost:6379/0

# 允许的主机
ALLOWED_HOSTS=localhost,127.0.0.1

# CORS配置
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# 密码加密密钥（32位，前后端必须一致，用于登录密码AES加密传输）
# 生成: python -c "import secrets; print(secrets.token_hex(16))"
PASSWORD_ENCRYPT_KEY=
VITE_PASSWORD_ENCRYPT_KEY=

# 初始化管理员密码（Docker entrypoint 首次创建 admin/wuhan 时使用，可选，缺省随机生成）
ADMIN_INIT_PASSWORD=
SUPERADMIN_INIT_PASSWORD=

# AI配置 (可选)
DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_SERVICE_URL=https://api.deepseek.com/v1/chat/completions
