{
  "name": "lims-frontend",
  "version": "2.0.0",
  "description": "LIMS 统一前端项目 - PC端 + 移动端",
  "author": "SXSInfo Team",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev:pc": "vite --config vite.config.pc.js",
    "dev:mobile": "vite --config vite.config.mobile.js",
    "build:pc": "vite build --config vite.config.pc.js",
    "build:mobile": "vite build --config vite.config.mobile.js",
    "preview:pc": "vite preview --config vite.config.pc.js",
    "preview:mobile": "vite preview --config vite.config.mobile.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .eslintignore",
    "lint:check": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --ignore-path .eslintignore"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "crypto-js": "^4.2.0",
    "echarts": "^5.5.0",
    "element-plus": "^2.11.8",
    "flexsearch": "^0.8.212",
    "pinia": "^3.0.4",
    "vant": "^4.9.0",
    "vue": "^3.5.22",
    "vue-echarts": "^6.6.0",
    "vue-router": "^4.6.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.1",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.27.0",
    "terser": "^5.36.0",
    "unplugin-auto-import": "^20.2.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.1.11"
  }
}
