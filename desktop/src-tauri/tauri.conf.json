{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LIMS",
  "version": "1.0.0",
  "identifier": "com.sxsinfo.lims.desktop",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist/pc",
    "beforeDevCommand": "yarn --cwd frontend dev:pc",
    "beforeBuildCommand": "yarn --cwd frontend build:pc"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "SXSInfo",
    "copyright": "Copyright © 2026 SXSInfo",
    "category": "Education",
    "shortDescription": "实训室信息管理系统 桌面端",
    "longDescription": "实训室信息管理系统（LIMS）桌面客户端，提供实训室、课表、使用记录、工单、设备与统计等管理能力。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "perMachine",
        "languages": ["SimpChinese"]
      }
    }
  }
}
